# ==========================================
# EduTrack Frontend Environment Variables Example
# ==========================================

# Public Backend API URL (Points to the deployed production backend)
NEXT_PUBLIC_API_URL="https://edutrackapplication.covenantsynergy.in/api"

# Public Razorpay Key ID (Safe for client-side checkout; never put KEY_SECRET here)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_your_public_key_id"

# Google Maps API Key (For Bus Tracking & Geolocation)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Firebase Web Client Configuration (For client notifications/assets)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-MEASUREMENTID"
