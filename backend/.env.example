# ==========================================
# EduTrack Backend Environment Variables Example
# ==========================================

# Database & Connection Pooling
DATABASE_URL="postgresql://username:password@host:5432/database_name?sslmode=require&connection_limit=5"
DIRECT_URL="postgresql://username:password@host:5432/database_name?sslmode=require"

# Server Configuration
PORT=3001
NODE_ENV="production"
CORS_ORIGINS="https://edutrackapplication.covenantsynergy.in,http://localhost:3000"

# JWT Authentication
JWT_SECRET="your-256-bit-secret-here"
JWT_EXPIRATION="24h"
JWT_REFRESH_SECRET="your-256-bit-refresh-secret-here"
JWT_REFRESH_EXPIRATION="7d"

# Razorpay Gateway Configuration (Backend)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# AWS S3 Storage (Optional Media / Reports)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET_NAME="edutrack-saas-media"

# Firebase Cloud Messaging / Admin (Optional Service Account)
FIREBASE_CREDENTIALS_PATH="./firebase-service-account.json"

# Operational Flags
ALLOW_DESTRUCTIVE_SEED=false
STUDENT_ADMISSION_DELAY=0
DISABLE_OTP_SECURITY=false
