  updatedAt        DateTime      @updatedAt
  gpsLogs          BusGpsLog[]
  bus              Bus           @relation(fields: [busId], references: [id], onDelete: Cascade)
  driver           StaffProfile? @relation(fields: [driverId], references: [id])
  route            BusRoute?     @relation(fields: [routeId], references: [id])
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([busId])
}

model BusGpsLog {
  id           String   @id @default(uuid())
  busId        String
  tripId       String?
  driverId     String?
  latitude     Float
  longitude    Float
  speed        Float?
  heading      Float?
  dutyStatus   String?
  batteryLevel Int?
