generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                   String                        @id @default(uuid())
  name                 String
  subDomain            String                        @unique
  logoUrl              String?
  address              String?
  email                String?
  phone                String?
  subtitle             String?
  setupCompleted       Boolean                       @default(false)
  bankName             String?
  bankBranch           String?
  bankIFSC             String?
  bankAccountNo        String?
  googlePayId          String?
  phonePeId            String?
  upiQrId              String?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  academicYears        AcademicYear[]
  activityLogs         ActivityLog[]
  announcements        Announcement[]
  attendances          Attendance[]
  attendanceSess       AttendanceSession[]
  behaviorCases        BehaviorCase[]
  books                Book[]
  bookCopies           BookCopy[]
  bookIssues           BookIssue[]
  buses                Bus[]
  busGpsLogs           BusGpsLog[]
  busRoutes            BusRoute[]
  busTrips             BusTrip[]
  classes              Class[]
  classSections        ClassSection[]
  classSubjects        ClassSubject[]
  complaints           Complaint[]
  exams                Exam[]
  examConfigs          ExamConfig[]
  examConfigSubjects   ExamConfigSubject[]
  examMarks            ExamMark[]
  examSchedules        ExamSchedule[]
  examSubjects         ExamSubject[]
  examTypes            ExamType[]
  expenses             Expense[]
  homeworks            Homework[]
  invoices             Invoice[]
  invoiceItems         InvoiceItem[]
  leaveRequests        LeaveRequest[]
  opportunities        Opportunity[]
  opportunityLineItems OpportunityLineItem[]
  periods              Period[]
  periodTimings        PeriodTiming[]
  pricebooks           Pricebook[]
  pricebookEntries     PricebookEntry[]
  products             Product[]
  schoolSetup          SchoolSetup?
  sections             Section[]
  staffProfiles        StaffProfile[]
  statusHistories      StatusHistory[]
  studentProfiles      StudentProfile[]
  subjects             Subject[]
  subjectComponents    SubjectComponent[]
  subHistories         SubscriptionHistory[]
  subInvoices          SubscriptionInvoice[]
  subNotifications     SubscriptionNotificationLog[]
  subPayments          SubscriptionPayment[]
  teacherAssigns       TeacherAssignment[]
  teacherSkills        TeacherSkill[]
  subscription         TenantSubscription?
  timetableConfig      TimetableConfig?
  users                User[]
}

model User {
  id                     String                   @id @default(uuid())
  email                  String?                  @unique
  passwordHash           String
  name                   String
  role                   Role
  phone                  String?
  isActive               Boolean                  @default(true)
  tenantId               String
  avatarUrl              String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  activityLogs           ActivityLog[]
  bookIssues             BookIssue[]
  createdCommunications  Communication[]          @relation("CreatedCommunications")
  CommunicationRecipient CommunicationRecipient[]
  assignedComplaints     Complaint[]              @relation("AssignedComplaints")
  complaints             Complaint[]
  approvedLeaves         LeaveRequest[]           @relation("ApprovedLeaves")
  submittedLeaves        LeaveRequest[]           @relation("SubmittedLeaves")
  notifications          Notification[]
  parentProfile          ParentProfile?
  staffProfile           StaffProfile?
  statusHistories        StatusHistory[]
  studentProfile         StudentProfile?
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([name])
  @@index([phone])
  @@index([tenantId, name, isActive])
}

model StaffProfile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  employeeId         String?
  designation        String?
  basicSalary        Decimal?            @db.Decimal(12, 2)
  allowances         Decimal?            @db.Decimal(12, 2)
  deductions         Decimal?            @db.Decimal(12, 2)
  pfDeduction        Decimal?            @db.Decimal(12, 2)
  joiningDate        DateTime?
  status             String?
  qualification      String?
  subjectsTaught     String[]
  staffCategory      String?             @default("TEACHING")
  staffRole          String?
  licenseNumber      String?
  licenseExpiry      DateTime?
  experienceYears    Int?
  bloodGroup         String?
  aadhaarNo          String?
  whatsappNumber     String?
  address            String?
  emergencyContact   String?
  tenantId           String
  announcements      Announcement[]
  attendanceSessions AttendanceSession[]
  behaviorCases      BehaviorCase[]
  assignedBus        Bus?                @relation("AssignedDriver")
  busTrips           BusTrip[]
  classSections      ClassSection[]
  homeworks          Homework[]
  leaveRequests      LeaveRequest[]
  substitutePeriods  Period[]            @relation("SubstituteTeacher")
  periods            Period[]            @relation("AssignedTeacher")
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]
  teacherSkills      TeacherSkill[]

  @@index([tenantId])
}

model ParentProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  emergencyContact String?
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentStudents   ParentStudent[]
  students         StudentProfile[]
}

model StudentProfile {
  id              String          @id @default(uuid())
  userId          String          @unique
  rollNo          String?
  fatherName      String?
  motherName      String?
  aadharNo        String?
  profilePhotoUrl String?
  fatherPhone     String?
  motherPhone     String?
  guardianPhone   String?
  parentProfileId String?
  classSectionId  String?
  busId           String?
  busStopId       String?
  tenantId        String
  attendances     Attendance[]
  behaviorCases   BehaviorCase[]
  examMarks       ExamMark[]
  invoices        Invoice[]
  leaveRequests   LeaveRequest[]
  opportunities   Opportunity[]
  parentStudents  ParentStudent[]
  bus             Bus?            @relation(fields: [busId], references: [id])
  busStop         BusStop?        @relation(fields: [busStopId], references: [id])
  classSection    ClassSection?   @relation(fields: [classSectionId], references: [id])
  parentProfile   ParentProfile?  @relation(fields: [parentProfileId], references: [id])
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([classSectionId])
  @@index([rollNo])
}

model AcademicYear {
  id            String         @id @default(uuid())
  name          String
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean        @default(false)
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes       Class[]
  complaints    Complaint[]
  examConfigs   ExamConfig[]
  examSchedules ExamSchedule[]
  opportunities Opportunity[]
  pricebooks    Pricebook[]

  @@index([tenantId])
}

model Class {
  id             String         @id @default(uuid())
  name           String
  isActive       Boolean        @default(true)
  academicYearId String
  tenantId       String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id])
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classSections  ClassSection[]
  examConfigs    ExamConfig[]
  opportunities  Opportunity[]
  pricebooks     Pricebook[]

  @@index([tenantId])
  @@index([academicYearId])
}

model Section {
  id            String         @id @default(uuid())
  name          String
  isActive      Boolean        @default(true)
  tenantId      String
  classSections ClassSection[]
  opportunities Opportunity[]
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ClassSection {
  id                 String              @id @default(uuid())
  classId            String
  sectionId          String
  strength           Int                 @default(0)
  teacherId          String?
  tenantId           String
  announcements      Announcement[]
  attendanceSessions AttendanceSession[]
  class              Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  section            Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher            StaffProfile?       @relation(fields: [teacherId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classSubjects      ClassSubject[]
  complaints         Complaint[]
  exams              Exam[]
  examSchedules      ExamSchedule[]
  homeworks          Homework[]
  leaveRequests      LeaveRequest[]
  periods            Period[]
  students           StudentProfile[]
  teacherAssigns     TeacherAssignment[]

  @@unique([classId, sectionId])
  @@index([tenantId])
  @@index([teacherId])
  @@index([classId])
  @@index([sectionId])
}

model Subject {
  id                 String              @id @default(uuid())
  name               String
  isActive           Boolean             @default(true)
  tenantId           String
  classSubjects      ClassSubject[]
  examConfigSubjects ExamConfigSubject[]
  examMarks          ExamMark[]
  examSchedules      ExamSchedule[]
  examSubjects       ExamSubject[]
  homeworks          Homework[]
  periods            Period[]
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherAssigns     TeacherAssignment[]
  teacherSkills      TeacherSkill[]

  @@index([tenantId])
}

model ClassSubject {
  id             String       @id @default(uuid())
  classSectionId String
  subjectId      String
  tenantId       String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([classSectionId, subjectId])
  @@index([tenantId])
}

model TeacherAssignment {
  id             String       @id @default(uuid())
  teacherId      String
  classSectionId String
  subjectId      String
  periodsPerWeek Int          @default(0)
  tenantId       String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        StaffProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classSectionId, subjectId])
  @@index([tenantId])
}

model AttendanceSession {
  id             String       @id @default(uuid())
  date           DateTime     @db.Date
  classSectionId String
  takenById      String
  presentCount   Int          @default(0)
  absentCount    Int          @default(0)
  totalStudents  Int          @default(0)
  tenantId       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  attendances    Attendance[]
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  takenBy        StaffProfile @relation(fields: [takenById], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([classSectionId])
  @@index([date])
}

model Attendance {
  id                  String            @id @default(uuid())
  attendanceSessionId String
  studentId           String
  status              AttendanceStatus
  reason              String?
  tenantId            String
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student             StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId])
  @@index([attendanceSessionId])
}

model Exam {
  id             String        @id @default(uuid())
  name           String
  type           String
  classSectionId String
  date           DateTime      @db.Date
  tenantId       String
  classSection   ClassSection  @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  examMarks      ExamMark[]
  examSubjects   ExamSubject[]

  @@index([tenantId])
  @@index([classSectionId])
  @@index([date])
}

model ExamMark {
  id            String         @id @default(uuid())
  examId        String
  studentId     String
  subjectId     String
  subjectType   String         @default("Theory") @db.VarChar(20)
  marksObtained Decimal        @db.Decimal(5, 2)
  remarks       String?
  tenantId      String
  exam          Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId, subjectId, subjectType])
  @@index([tenantId, studentId])
  @@index([tenantId, examId])
}

model Invoice {
  id                String         @id @default(uuid())
  studentId         String
  invoiceDate       DateTime       @db.Date
  dueDate           DateTime       @db.Date
  totalAmount       Decimal        @db.Decimal(12, 2)
  paidAmount        Decimal        @default(0) @db.Decimal(12, 2)
  remainingBalance  Decimal        @db.Decimal(12, 2)
  status            PaymentStatus
  paymentMethod     PaymentMethod?
  description       String?
  tenantId          String
  opportunityId     String?
  bankName          String?
  bankIFSC          String?
  bankAccountNumber String?
  bankBranch        String?
  opportunity       Opportunity?   @relation(fields: [opportunityId], references: [id])
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceItems      InvoiceItem[]

  @@index([tenantId])
  @@index([studentId])
  @@index([status])
  @@index([invoiceDate])
}

model InvoiceItem {
  id                    String               @id @default(uuid())
  invoiceId             String
  name                  String
  amount                Decimal              @db.Decimal(12, 2)
  tenantId              String
  opportunityLineItemId String?
  productId             String?
  invoice               Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  opportunityLineItem   OpportunityLineItem? @relation(fields: [opportunityLineItemId], references: [id])
  product               Product?             @relation(fields: [productId], references: [id])
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
}

model Expense {
  id          String        @id @default(uuid())
  amount      Decimal       @db.Decimal(12, 2)
  category    String
  date        DateTime      @db.Date
  description String?
  paymentMode String
  status      ExpenseStatus @default(PENDING)
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([category])
  @@index([status])
  @@index([date])
}

model PeriodTiming {
  id           String   @id @default(uuid())
  periodNumber Int
  name         String   @default("")
  isBreak      Boolean  @default(false)
  startTime    String
  endTime      String
  isActive     Boolean  @default(true)
  tenantId     String
  periods      Period[]
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Period {
  id                  String        @id @default(uuid())
  classSectionId      String
  subjectId           String
  teacherId           String
  substituteTeacherId String?
  periodTimingId      String
  dayOfWeek           String
  tenantId            String
  classSection        ClassSection  @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  periodTiming        PeriodTiming  @relation(fields: [periodTimingId], references: [id], onDelete: Cascade)
  subject             Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  substituteTeacher   StaffProfile? @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id])
  teacher             StaffProfile  @relation("AssignedTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([teacherId])
  @@index([classSectionId])
  @@index([dayOfWeek])
}

model TeacherSkill {
  id                String       @id @default(uuid())
  teacherId         String
  subjectId         String
  skillLevel        String?
  yearsOfExperience Int?
  tenantId          String
  subject           Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher           StaffProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([tenantId])
}

model Complaint {
  id              String        @id @default(uuid())
  title           String
  description     String
  status          String        @default("OPEN")
  category        String
  submittedById   String
  assignedToId    String?
  adminReply      String?
  resolutionNotes String?
  academicYearId  String
  classSectionId  String?
  tenantId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id])
  assignedTo      User?         @relation("AssignedComplaints", fields: [assignedToId], references: [id])
  classSection    ClassSection? @relation(fields: [classSectionId], references: [id])
  submittedBy     User          @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([submittedById])
}

model Book {
  id              String     @id @default(uuid())
  title           String
  author          String
  isbn            String?
  category        String?
  totalCopies     Int        @default(0)
  availableCopies Int        @default(0)
  tenantId        String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  copies          BookCopy[]
}

model BookCopy {
  id        String         @id @default(uuid())
  bookId    String
  barcode   String         @unique
  status    BookCopyStatus @default(AVAILABLE)
  tenantId  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  book      Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issues    BookIssue[]
}

model BookIssue {
  id         String    @id @default(uuid())
  bookCopyId String
  borrowerId String
  issueDate  DateTime  @default(now())
  dueDate    DateTime
  returnDate DateTime?
  fineAmount Decimal   @default(0) @db.Decimal(8, 2)
  finePaid   Boolean   @default(false)
  tenantId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  bookCopy   BookCopy  @relation(fields: [bookCopyId], references: [id], onDelete: Cascade)
  borrower   User      @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  message     String
  type        String
  recipientId String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityName String
  entityId   String?
  details    String?
  tenantId   String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id                   String                @id @default(uuid())
  name                 String
  description          String?
  productCode          String?
  isActive             Boolean               @default(true)
  tenantId             String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  invoiceItems         InvoiceItem[]
  opportunityLineItems OpportunityLineItem[]
  pricebookEntries     PricebookEntry[]
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Pricebook {
  id               String           @id @default(uuid())
  name             String
  isActive         Boolean          @default(true)
  academicYearId   String?
  classId          String?
  tenantId         String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  academicYear     AcademicYear?    @relation(fields: [academicYearId], references: [id])
  class            Class?           @relation(fields: [classId], references: [id])
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pricebookEntries PricebookEntry[]

  @@unique([tenantId, classId, academicYearId])
}

model PricebookEntry {
  id                   String                @id @default(uuid())
  pricebookId          String
  productId            String
  unitPrice            Decimal               @db.Decimal(12, 2)
  isActive             Boolean               @default(true)
  tenantId             String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  opportunityLineItems OpportunityLineItem[]
  pricebook            Pricebook             @relation(fields: [pricebookId], references: [id], onDelete: Cascade)
  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Opportunity {
  id                   String                @id @default(uuid())
  name                 String
  studentId            String
  stageName            String
  closeDate            DateTime
  classId              String?
  sectionId            String?
  academicYearId       String?
  totalPaidAmount      Decimal               @default(0) @db.Decimal(12, 2)
  tenantId             String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  invoices             Invoice[]
  academicYear         AcademicYear?         @relation(fields: [academicYearId], references: [id])
  class                Class?                @relation(fields: [classId], references: [id])
  section              Section?              @relation(fields: [sectionId], references: [id])
  student              StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunityLineItems OpportunityLineItem[]
}

model OpportunityLineItem {
  id               String         @id @default(uuid())
  opportunityId    String
  pricebookEntryId String
  productId        String
  quantity         Decimal        @default(1) @db.Decimal(12, 2)
  unitPrice        Decimal        @db.Decimal(12, 2)
  discount         Decimal        @default(0) @db.Decimal(5, 2)
  tenantId         String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  invoiceItems     InvoiceItem[]
  opportunity      Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  pricebookEntry   PricebookEntry @relation(fields: [pricebookEntryId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BehaviorCase {
  id           String         @id @default(uuid())
  tenantId     String
  studentId    String
  teacherId    String?
  behaviorType String
  category     String
  academicYear String
  status       String         @default("New")
  priority     String
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher      StaffProfile?  @relation(fields: [teacherId], references: [id])
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
}

model OtpRequest {
  id        String   @id @default(uuid())
  phone     String
  otpCode   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model SchoolSetup {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  schoolName    String
  schoolType    String
  adminName     String
  mobileNumber  String
  email         String
  address       String
  academicYear  String
  principalName String   @default("")
  country       String   @default("")
  state         String   @default("")
  district      String   @default("")
