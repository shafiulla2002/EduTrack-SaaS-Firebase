  @@unique([parentId, studentId])
}

model Bus {
  id             String           @id @default(uuid())
  busNumber      String
  registrationNo String
  vehicleModel   String?
  capacity       Int              @default(40)
  busPhotoUrl    String?
  pickupTime     String?
  dropTime       String?
  status         String           @default("ACTIVE")
  dutyStatus     String           @default("OFF_DUTY")
  driverId       String?          @unique
  routeId        String?
  currentLat     Float?
  currentLng     Float?
  currentSpeed   Float?
  currentHeading Float?
  lastGpsUpdate  DateTime?
  batteryLevel   Int?
  tenantId       String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  driver         StaffProfile?    @relation("AssignedDriver", fields: [driverId], references: [id])
  route          BusRoute?        @relation(fields: [routeId], references: [id])
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gpsLogs        BusGpsLog[]
  trips          BusTrip[]
  students       StudentProfile[]

  @@index([tenantId])
}

model BusRoute {
  id          String    @id @default(uuid())
  routeName   String
  startPoint  String?
  endPoint    String?
  description String?
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  buses       Bus[]
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stops       BusStop[]
  trips       BusTrip[]

  @@index([tenantId])
}

model BusStop {
  id            String           @id @default(uuid())
  stopName      String
  sequenceOrder Int              @default(1)
  pickupTime    String?
  dropTime      String?
  lat           Float            @default(0.0)
  lng           Float            @default(0.0)
