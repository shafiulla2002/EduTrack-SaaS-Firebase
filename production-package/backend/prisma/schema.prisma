  @@index([tenantId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([createdDate])
}

model SubscriptionPayment {
  id                    String               @id @default(uuid())
  tenantId              String
  schoolId              String?
  planId                String?
  billingDurationMonths Int?                 @default(12)
  currency              String               @default("INR")
  method                String?              @default("RAZORPAY")
  gateway               String
  gatewayReference      String?
