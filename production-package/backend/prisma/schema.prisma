model SubscriptionPlan {
  id             String               @id @default(uuid())
  name           PlanType             @unique
  studentLimit   Int?
  teacherLimit   Int?
  parentLimit    Int?
  storageLimit   Decimal?             @db.Decimal(12, 2)
