  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip         BusTrip? @relation(fields: [tripId], references: [id])

  @@index([tenantId])
  @@index([busId])
  @@index([tripId])
}

model SubjectComponent {
